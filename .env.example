# Copy to .env and fill in. Never commit .env.

# Liiga API
LIIGA_BASE_URL=https://prod.liiga-backend.liiga.fi/stats/api/v1
LIIGA_API_KEY=
LIIGA_API_KEY_HEADER=x-api-key
CURRENT_SEASON=2027

# LLM (newsroom, person B): Gemini free tier through its OpenAI-compatible endpoint
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=
LLM_API_KEY=
LLM_API_KEYS=
STORY_LANG=en

# Engine
SEED=42
# Runs per /api/simulate call (default 5000). The Render free plan uses 2000 to stay under 3 s.
# RUNS_SIMULATE_API=2000

# API CORS: deployed frontend URL
FRONTEND_URL=
